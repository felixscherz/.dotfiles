{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "github-copilot/gpt-5.6-luna",
  "share": "disabled",
  "formatter": true,
  "disabled_providers": [
    "openai",
    "anthropic",
    "gemini",
    "amazon-bedrock",
    "google",
  ],
  "permission": {
    "github*": "deny",
    "grafana*": "deny",
    "atlassian*": "deny"
  },
  "provider": {
    "github-copilot": {
      "whitelist": [
        "claude-sonnet-5", // versatile
        "claude-opus-5", // powerful
        "gpt-5.6-luna" // cheapest
      ]
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "m5-qwen2.5-coder-32k": {
          "name": "M5 Qwen2.5 Coder 32k",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "m5-qwen3.6-48k": {
          "name": "M5 Qwen3.6 48k",
          "limit": {
            "context": 49152,
            "output": 8192
          }
        },
        "m5-gemma4-qat-48k": {
          "name": "Gemma4-QAT 48k",
          "cost": {
            "input": 1000,
            "output": 1000
          },
          "limit": {
            "context": 49152,
            "output": 8192
          }
        },
        "m5-gemma4-e4b-64k": {
          "name": "Gemma4 E4B",
          "limit":{
            "context": 64000,
            "output": 8192
          }
        }
      }
    }
  }
}
