{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "github-copilot/claude-sonnet-5",
  "share": "disabled",
  "formatter": true,
  "disabled_providers": [
    "openai",
    "anthropic",
    "gemini",
    "amazon-bedrock",
    "google",
  ],
  "permission": {
    "github*": "deny",
    "grafana*": "deny",
    "atlassian*": "deny"
  },
  "provider": {
    "github-copilot": {"whitelist": ["claude-sonnet-5", "claude-opus-4.8", "claude-haiku-4.5"]},
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:local-64k": {
          "name": "Gemma4 64k"
        },
        "m5-qwen2.5-coder-32k": {
          "name": "M5 Qwen2.5 Coder 32k"
        },
        "m5-qwen3.6-48k": {
          "name": "M5 Qwen3.6 48k"
        },
        "m5-gemma4-qat-48k": {
          "name": "Gemma4-QAT 48k",
          "cost": {
            "input": 1000,
            "output": 1000
          },
        }
      }
    }
  }
}
