{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "github-copilot/gpt-5.6-luna",
  "share": "disabled",
  "formatter": true,
  "disabled_providers": [
    "openai",
    "anthropic",
    "gemini",
    "amazon-bedrock",
    "google",
  ],
  "permission": {
    "github*": "deny",
    "grafana*": "deny",
    "atlassian*": "deny",
    "skill": {
      "*": "allow",
      "handoff": "deny",
      "setup-agents": "deny",
      "to-spec": "deny",
      "to-tickets": "deny",
      "batch-implement": "deny"
    }
  },
  "provider": {
    "github-copilot": {
      "whitelist": [
        "claude-sonnet-5", // versatile
        "claude-opus-5", // powerful
        "claude-opus-4.8", // powerful
        "gpt-5.6-terra", // midlevel
        "gpt-5.6-luna" // cheapest
      ]
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (Local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen/qwen3.6-27b": {
          "name": "Qwen3.6 27b",
          "limit": {
            "context": 49152,
            "output": 8192
          }
        },
        "google/gemma-4-26b-a4b-qat": {
          "name": "Gemma4 26B A4B QAT",
          "limit": {
            "context": 49152,
            "output": 8192
          }
        },
        "google/gemma-4-12b-qat": {
          "name": "Gemma4 12B QAT",
          "limit": {
            "context": 49152,
            "output": 8192
          }
        },
        "google/gemma-4-e4b": {
          "name": "Gemma4 E4B",
          "limit": {
            "context": 64000,
            "output": 8192
          }
        }
      }
    }
  }
}
