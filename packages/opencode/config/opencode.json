{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "github-copilot/gpt-6-sol",
  "share": "disabled",
  "formatter": true,
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "openai", "effect": "deny" },
      { "action": "provider.use", "resource": "anthropic", "effect": "deny" },
      { "action": "provider.use", "resource": "gemini", "effect": "deny" },
      { "action": "provider.use", "resource": "amazon-bedrock", "effect": "deny" },
      { "action": "provider.use", "resource": "google", "effect": "deny" }
    ]
  },
  "permissions": [
    { "action": "github*", "resource": "*", "effect": "deny" },
    { "action": "grafana*", "resource": "*", "effect": "deny" },
    { "action": "atlassian*", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "handoff", "effect": "deny" },
    { "action": "skill", "resource": "setup-agents", "effect": "deny" },
    { "action": "skill", "resource": "setup-repository", "effect": "deny" },
    { "action": "skill", "resource": "to-spec", "effect": "deny" },
    { "action": "skill", "resource": "to-tickets", "effect": "deny" },
    { "action": "skill", "resource": "batch-implement", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.agents/skills/config/skills/engineering/references/*", "effect": "allow" },
    { "action": "read", "resource": "~/.agents/skills/config/skills/engineering/references/*", "effect": "allow" }
  ],
  "providers": {
    "github-copilot": {
      // V2 has no model whitelist; disable models outside the former list.
      // Recheck this list when Copilot adds models.
      "models": {
        "claude-opus-5.5": { "disabled": true },
        "grok-4.7": { "disabled": true },
        "gpt-6-astra": { "disabled": true },
        "gemini-3.8-flash": { "disabled": true },
        "claude-fable-5.1": { "disabled": true },
        "gemini-3.7-flash": { "disabled": true },
        "grok-4.6": { "disabled": true },
        "mai-code-1.1-flash": { "disabled": true },
        "gemini-3.6-flash": { "disabled": true },
        "gpt-5.6-sol": { "disabled": true },
        "grok-4.5": { "disabled": true },
        "kimi-k2.7-code": { "disabled": true },
        "claude-fable-5": { "disabled": true },
        "claude-opus-4.8-fast": { "disabled": true },
        "gemini-3.5-flash": { "disabled": true },
        "gpt-5.5": { "disabled": true },
        "claude-opus-4.7": { "disabled": true },
        "claude-opus-4.7-fast": { "disabled": true },
        "gpt-5.4-mini": { "disabled": true },
        "gpt-5.4": { "disabled": true },
        "gpt-5.3-codex": { "disabled": true },
        "claude-haiku-4.5": { "disabled": true },
        "gpt-5-mini": { "disabled": true }
      }
    },
    "lmstudio": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LM Studio (Local)",
      "settings": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen/qwen3.6-27b": {
          "name": "Qwen3.6 27b",
          "limit": {
            "context": 49152,
            "output": 8192
          }
        },
        "google/gemma-4-26b-a4b-qat": {
          "name": "Gemma4 26B A4B QAT",
          "limit": {
            "context": 49152,
            "output": 8192
          }
        },
        "google/gemma-4-12b-qat": {
          "name": "Gemma4 12B QAT",
          "limit": {
            "context": 49152,
            "output": 8192
          }
        },
        "google/gemma-4-e4b": {
          "name": "Gemma4 E4B",
          "limit": {
            "context": 64000,
            "output": 8192
          }
        }
      }
    }
  }
}
